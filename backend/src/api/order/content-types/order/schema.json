{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "orderType": {
      "type": "enumeration",
      "enum": [
        "ONLINE",
        "COUNTER",
        "DELIVERY",
        "PICKUP"
      ]
    },
    "statusOrder": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "PREPARING",
        "READY",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "PARTIAL",
        "PAID",
        "REFUNDED"
      ]
    },
    "subtotal": {
      "type": "decimal",
      "required": true
    },
    "discount": {
      "type": "decimal",
      "required": false,
      "default": 0
    },
    "total": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "orderedAt": {
      "type": "datetime",
      "required": true
    },
    "completeAt": {
      "type": "datetime"
    },
    "restaurant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::restaurant.restaurant",
      "inversedBy": "orders"
    },
    "order_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "payments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment.payment",
      "mappedBy": "order"
    },
    "users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "orders"
    }
  }
}
