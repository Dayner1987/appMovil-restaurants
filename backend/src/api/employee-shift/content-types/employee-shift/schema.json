{
  "kind": "collectionType",
  "collectionName": "employee_shifts",
  "info": {
    "singularName": "employee-shift",
    "pluralName": "employee-shifts",
    "displayName": "EmployeeShift"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "startedAt": {
      "type": "datetime"
    },
    "endedAt": {
      "type": "datetime"
    },
    "statusEm": {
