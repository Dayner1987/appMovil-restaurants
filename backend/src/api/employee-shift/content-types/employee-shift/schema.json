    },
    "restaurant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::restaurant.restaurant",
      "inversedBy": "employee_shifts"
    },
    "employeeShift": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
