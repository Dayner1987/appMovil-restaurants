{
  "kind": "collectionType",
  "collectionName": "restaurant_applications",
  "info": {
    "singularName": "restaurant-application",
    "pluralName": "restaurant-applications",
    "displayName": "Restaurant Application"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "proposedRestaurantName": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "required": true,
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "rejectionReason": {
      "type": "text"
    },
    "reviewedAt": {
      "type": "datetime"
    },
    "applicant": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}